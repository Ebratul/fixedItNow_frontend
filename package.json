{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:browser": "node e2e/browse.mjs",
    "e2e:auth": "node e2e/auth-otp.mjs",
    "e2e:admin": "node e2e/admin.mjs",
    "e2e:workflow": "node e2e/workflow.mjs",
    "e2e:demo": "node e2e/demo.mjs",
    "build:perf": "set -a && . ./.env.perf && set +a && next build",
    "start:perf": "set -a && . ./.env.perf && set +a && next start -p 3100",
    "dev:perf": "set -a && . ./.env.perf && set +a && NEXT_PUBLIC_SITE_URL=http://localhost:3101 next dev -p 3101"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "better-auth": "^1.7.12",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
