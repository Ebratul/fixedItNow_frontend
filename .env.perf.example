# Web app environment for LOCAL PERFORMANCE TESTING (backend/docs/PERFORMANCE.md). Copy to .env.perf.
# Loaded by `npm run build:perf` / `npm run start:perf` only; `npm run dev` keeps using .env (BACKEND_URL :4000).
# BACKEND_URL is baked into the /api/v1 rewrite at build time: rebuild after changing it.
BACKEND_URL=http://localhost:4100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
